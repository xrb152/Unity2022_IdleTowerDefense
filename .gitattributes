# 统一源码换行符
*.cs         text eol=lf
*.asmdef     text eol=lf
*.asmref     text eol=lf
*.json       text eol=lf
*.xml        text eol=lf
*.txt        text eol=lf
*.md         text eol=lf
*.sh         text eol=lf
*.rsp        text eol=lf

# Unity 序列化文件按原样存储，禁止换行符自动转换
# （Windows 常见 core.autocrlf=true 会破坏 YAML / 场景序列化）
*.unity            -text
*.prefab           -text
*.asset            -text
*.mat              -text
*.anim             -text
*.controller       -text
*.overridecontroller -text
*.physicsMaterial  -text
*.physicsMaterial2D -text
*.spriteatlas      -text
*.renderTexture    -text
*.lighting         -text
*.preset           -text
*.meta             -text

# 二进制资源
*.png        binary
*.jpg        binary
*.jpeg       binary
*.tga        binary
*.psd        binary
*.exr        binary
*.tif        binary
*.ttf        binary
*.otf        binary
*.wav        binary
*.mp3        binary
*.ogg        binary
*.so         binary
*.a          binary
*.dll        binary
*.aar        binary
*.srcaar     binary
*.jar        binary
*.unitypackage binary
